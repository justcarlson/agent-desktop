#!/bin/bash
# Runs a command in a throwaway Omarchy VM, the way Omarchy tests itself.
# Adapted from omacom/omarchy test/ci-vm and .github/workflows/test.yml, and
# omacom/omarchy-iso test/vm-image/vm-boot (MIT). Stock: it holds no host,
# account or personal setting, so it can be copied into any repository.
#
#   omarchy-vm fetch [stable|edge]      download and verify the nightly VM image
#   omarchy-vm path [stable|edge]       print the image folder (for test/ci-vm)
#   omarchy-vm run [options] -- <cmd>   boot a fresh overlay, copy files in,
#                                       run <cmd> in the desktop session, copy
#                                       ~/out back, power off
#   omarchy-vm shell [stable|edge]      boot and print the ssh line; Ctrl-C ends it
#
# run options:
#   --channel stable|edge   image channel (default stable, as upstream CI)
#   --copy <path>           copy <path> into ~/src/<basename> (repeatable)
#   --pkg <name>            pacman package to install in the overlay first (repeatable)
#   --out <dir>             where ~/out lands on the host (default ./vm-out)
#
# The image folder holds base.qcow2, vmlinuz, initrd and cmdline, the layout
# test/ci-vm and vm-boot read. <cmd> runs as user omarchy through
# `systemd-run --user`, so it sees the session's Hyprland, Wayland and AT-SPI
# environment like an Omarchy terminal. OMARCHY_VM_CHANNEL and
# OMARCHY_VM_VERSION name the image. Input, windows and drawing stay inside the
# VM. The image is never written: vm-boot runs it on a copy-on-write overlay
# and deletes it on exit.
#
# Env: OMARCHY_VM_CACHE (~/.cache/omarchy-vm), SMP (4), MEM (8G), and the
# vm-boot variables (VM_STATE_DIR, QEMU_EXTRA, APPEND).
set -euo pipefail

cache=${OMARCHY_VM_CACHE:-$HOME/.cache/omarchy-vm}
site=https://nightly.omarchy.org

usage() { sed -n '2,29p' "$0" >&2; exit 2; }

channel_ok() { [[ $1 == "stable" || $1 == "edge" ]] || { echo "omarchy-vm: channel is stable or edge, not $1" >&2; exit 2; }; }

disk_ok() { (cd "$1" && echo "$(jq -r .vm.sha256 latest.json)  base.qcow2" | sha256sum -c --quiet - 2>/dev/null); }

fetch() {
  local channel=${1:-stable} version dir url file
  channel_ok "$channel"
  version=$(curl -fsS --retry 3 "$site/$channel/latest.json" | jq -r .version)
  dir=$cache/$channel/$version
  mkdir -p "$dir"
  curl -fsS --retry 3 -o "$dir/latest.json" "$site/$channel/latest.json"
  url=$(jq -r .vm.unpacked "$dir/latest.json")
  for file in $(jq -r '.vm.unpacked_files[]' "$dir/latest.json"); do
    curl -fsS --retry 3 -o "$dir/$file" "$url$file"
  done
  if ! [[ -s $dir/base.qcow2 ]] || ! disk_ok "$dir"; then
    url=$(jq -r .vm.url "$dir/latest.json")
    if command -v aria2c >/dev/null; then
      aria2c --quiet -x 16 -s 16 -c -d "$dir" -o base.qcow2 "$url"
    else
      curl -fL --retry 3 -C - -o "$dir/base.qcow2" "$url"
    fi
  fi
  # SHA256SUMS covers the unpacked files; latest.json carries the disk's sum.
  if ! (cd "$dir" && sha256sum -c --quiet SHA256SUMS) || ! disk_ok "$dir"; then
    echo "omarchy-vm: $dir does not match its checksums" >&2
    exit 1
  fi
  chmod +x "$dir/vm-boot"
  ln -sfn "$version" "$cache/$channel/current"
  echo "omarchy-vm: $channel $version (Omarchy $(jq -r .omarchy_version "$dir/latest.json")) ready in $dir" >&2
}

image_dir() {
  local dir=$cache/$1/current
  [[ -s $dir/base.qcow2 ]] || { echo "omarchy-vm: no $1 image; run: omarchy-vm fetch $1" >&2; exit 1; }
  realpath "$dir"
}

# Runs inside the VM over ssh. stdin is the tar of --copy paths; stdout is
# reserved for the tar of ~/out, so everything else goes to stderr.
read -r -d '' guest <<'GUEST' || true
set -euo pipefail
mkdir -p ~/src ~/out && tar xf - -C ~/src
until systemctl --user show-environment | grep -q ^HYPRLAND_INSTANCE_SIGNATURE=; do
  (( SECONDS < 300 )) || { echo "omarchy-vm: no desktop session after 300 s" >&2; exit 1; }
  sleep 0.3
done
# Nobody touches this machine; without stay-awake the screen goes black.
systemd-run --user --quiet --collect --wait omarchy-toggle-idle stay-awake >/dev/null
if [[ -n $OMARCHY_VM_PKGS ]]; then
  # The image's sync databases are as old as the image: refresh them.
  echo omarchy | sudo -S -p '' pacman -Sy --noconfirm --needed $OMARCHY_VM_PKGS >&2
fi
echo "omarchy-vm: session up after ${SECONDS} s; $(omarchy-version)" >&2
rc=0
systemd-run --user --quiet --collect --wait --pipe -p WorkingDirectory=~/src \
  -E OMARCHY_VM_CHANNEL="$OMARCHY_VM_CHANNEL" -E OMARCHY_VM_VERSION="$OMARCHY_VM_VERSION" \
  bash -c "$OMARCHY_VM_CMD" </dev/null >&2 || rc=$?
echo "$rc" >~/out/rc
tar cf - -C ~/out .
GUEST

run() {
  local channel=stable out=./vm-out copies=() pkgs=()
  while (( $# )); do
    case $1 in
      --channel) channel_ok "$2"; channel=$2; shift 2 ;;
      --copy) copies+=("$(realpath -e "$2")"); shift 2 ;;
      --pkg) pkgs+=("$2"); shift 2 ;;
      --out) out=$2; shift 2 ;;
      --) shift; break ;;
      *) usage ;;
    esac
  done
  (( $# )) || usage
  local dir cmd version env
  dir=$(image_dir "$channel")
  version=$(jq -r .version "$dir/latest.json")
  printf -v cmd '%q ' "$@"
  mkdir -p "$out"
  rm -f "$out/rc"
  # Git metadata comes along, as in test/ci-vm; build output does not.
  local tar_args=(--exclude=.git/objects/pack/tmp_* --exclude=*/target --exclude=*/node_modules --exclude=*/.venv) path
  for path in "${copies[@]}"; do tar_args+=(-C "$(dirname "$path")" "$(basename "$path")"); done
  (( ${#copies[@]} )) || tar_args+=(-T /dev/null)
  printf -v env 'OMARCHY_VM_CMD=%q OMARCHY_VM_PKGS=%q OMARCHY_VM_CHANNEL=%q OMARCHY_VM_VERSION=%q' \
    "$cmd" "${pkgs[*]}" "$channel" "$version"
  tar cf - "${tar_args[@]}" | SMP=${SMP:-4} MEM=${MEM:-8G} "$dir/vm-boot" "$dir" \
      "$env bash -c $(printf %q "$guest")" |
    tar xf - --no-same-owner -C "$out"
  local rc
  rc=$(cat "$out/rc" 2>/dev/null || echo 1)
  echo "omarchy-vm: $channel $version, command exited $rc; output in $out" >&2
  return "$rc"
}

case ${1:-} in
  fetch) shift; fetch "$@" ;;
  path) shift; channel_ok "${1:-stable}"; image_dir "${1:-stable}" ;;
  run) shift; run "$@" ;;
  shell)
    shift
    channel=${1:-stable}
    channel_ok "$channel"
    dir=$(image_dir "$channel")
    SMP=${SMP:-4} MEM=${MEM:-8G} exec "$dir/vm-boot" "$dir"
    ;;
  *) usage ;;
esac
